<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="zsj.mockmate.mapper.authMapper">


    <!--根据username查询用户-->
    <select id="getByusername" resultType="zsj.mockmate.pojo.entity.UserEntity">
        select * from user_account where username = #{username}
    </select>
</mapper>